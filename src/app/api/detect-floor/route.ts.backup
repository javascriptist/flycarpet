import { NextRequest, NextResponse } from 'next/server'

/**
 * API Route: Floor Detection using Hugging Face Grounded-SAM
 * 
 * This endpoint receives a room photo and uses Hugging Face's Inference API
 * to detect the floor area using Grounded-SAM (Grounding DINO + SAM).
 * 
 * Model: IDEA-Research/grounding-dino-base + SAM
 * Prompt: "floor" or "floor area"
 * 
 * Returns: Floor segmentation mask and polygon coordinates
 */

const HUGGING_FACE_API_KEY = process.env.HUGGING_FACE_API_KEY

// Updated model - using Facebook's SAM (Segment Anything Model)
// This is more reliable and better supported than Grounded-SAM
const SAM_MODEL = 'facebook/sam-vit-huge'

interface SAMResponse {
  masks?: any[]
  scores?: number[]
  // SAM returns masks directly, we'll process them
}

export async function POST(request: NextRequest) {
  try {
    // Check if API key is configured
    if (!HUGGING_FACE_API_KEY) {
      return NextResponse.json(
        { 
          error: 'Hugging Face API key not configured',
          fallback: true // Tell frontend to use OpenCV fallback
        },
        { status: 500 }
      )
    }

    // Parse request body
    const body = await request.json()
    const { image, prompt = 'floor' } = body

    if (!image) {
      return NextResponse.json(
        { error: 'No image provided' },
        { status: 400 }
      )
    }

    console.log('🔍 Calling Hugging Face Grounded-SAM for floor detection...')
    console.log('  Model:', GROUNDED_SAM_MODEL)
    console.log('  Prompt:', prompt)

    // Convert base64 to buffer if needed
    let imageBuffer: Buffer
    if (image.startsWith('data:image')) {
      // Remove data URL prefix
      const base64Data = image.split(',')[1]
      imageBuffer = Buffer.from(base64Data, 'base64')
    } else if (image.startsWith('http')) {
      // Fetch image from URL
      const response = await fetch(image)
      const arrayBuffer = await response.arrayBuffer()
      imageBuffer = Buffer.from(arrayBuffer)
    } else {
      // Assume it's already base64
      imageBuffer = Buffer.from(image, 'base64')
    }

    console.log('  Image size:', imageBuffer.length, 'bytes')

    // Call Hugging Face Inference API
    const hfResponse = await fetch(
      `https://api-inference.huggingface.co/models/${GROUNDED_SAM_MODEL}`,
      {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${HUGGING_FACE_API_KEY}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          inputs: {
            image: imageBuffer.toString('base64'),
            text: prompt,
          },
          parameters: {
            threshold: 0.3, // Confidence threshold
            box_threshold: 0.25,
            text_threshold: 0.25,
          }
        }),
      }
    )

    if (!hfResponse.ok) {
      const errorText = await hfResponse.text()
      console.error('❌ Hugging Face API error:', errorText)
      
      // Check if model is loading
      if (errorText.includes('currently loading')) {
        return NextResponse.json(
          { 
            error: 'Model is loading, please try again in a moment',
            loading: true,
            estimatedTime: 20 // seconds
          },
          { status: 503 }
        )
      }

      return NextResponse.json(
        { 
          error: 'Floor detection failed',
          details: errorText,
          fallback: true // Use OpenCV fallback
        },
        { status: 500 }
      )
    }

    const result: GroundedSAMResponse = await hfResponse.json()

    console.log('✅ Received floor detection results:')
    console.log('  Detected regions:', result.masks?.length || 0)
    console.log('  Confidence scores:', result.scores)

    // Filter results for floor-related detections
    const floorResults = result.labels?.map((label, i) => ({
      mask: result.masks?.[i],
      box: result.boxes?.[i],
      score: result.scores?.[i],
      label: label
    })).filter(r => 
      r.label.toLowerCase().includes('floor') ||
      r.label.toLowerCase().includes('ground') ||
      r.score > 0.5 // High confidence detections
    ) || []

    if (floorResults.length === 0) {
      console.log('⚠️ No floor detected in image')
      return NextResponse.json(
        {
          error: 'No floor area detected',
          fallback: true,
          message: 'Could not detect floor in the image. Using fallback detection.'
        },
        { status: 200 }
      )
    }

    // Sort by confidence and take the best result
    const bestFloor = floorResults.sort((a, b) => b.score - a.score)[0]

    console.log('🎯 Best floor detection:')
    console.log('  Label:', bestFloor.label)
    console.log('  Confidence:', (bestFloor.score * 100).toFixed(1) + '%')
    console.log('  Bounding box:', bestFloor.box)

    // Convert mask to polygon coordinates (approximate)
    const polygon = boxToPolygon(bestFloor.box)

    return NextResponse.json({
      success: true,
      floor: {
        mask: bestFloor.mask, // Base64 encoded mask image
        polygon: polygon, // Corner points for easy rendering
        boundingBox: bestFloor.box,
        confidence: bestFloor.score,
        label: bestFloor.label
      },
      alternatives: floorResults.slice(1, 3).map(r => ({
        polygon: boxToPolygon(r.box),
        confidence: r.score,
        label: r.label
      }))
    })

  } catch (error) {
    console.error('❌ Floor detection error:', error)
    return NextResponse.json(
      {
        error: 'Internal server error',
        message: error instanceof Error ? error.message : 'Unknown error',
        fallback: true
      },
      { status: 500 }
    )
  }
}

/**
 * Convert bounding box to polygon coordinates
 * Box format: [x1, y1, x2, y2]
 * Returns: { topLeft, topRight, bottomRight, bottomLeft }
 */
function boxToPolygon(box: number[]) {
  const [x1, y1, x2, y2] = box
  return {
    topLeft: { x: x1, y: y1 },
    topRight: { x: x2, y: y1 },
    bottomRight: { x: x2, y: y2 },
    bottomLeft: { x: x1, y: y2 }
  }
}

/**
 * Health check endpoint
 */
export async function GET() {
  return NextResponse.json({
    status: 'ok',
    model: GROUNDED_SAM_MODEL,
    apiKeyConfigured: !!HUGGING_FACE_API_KEY
  })
}
